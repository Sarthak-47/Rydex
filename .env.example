# =============================================================
# Rydex — Environment Configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# =============================================================

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (recommended for production) or MySQL
DATABASE_URL=postgresql://rydex_user:your_password@localhost:5432/rydex
# For MySQL: mysql+pymysql://rydex_user:your_password@localhost:3306/rydex

# ── Authentication ─────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRE_MINUTES=10080

# ── Weather API (OpenWeatherMap) ───────────────────────────────
# Sign up free at https://openweathermap.org/api
# Required for rainfall and heat triggers
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Air Quality API (CPCB / OpenAQ) ───────────────────────────
# Sign up at https://api.openaq.org or https://cpcb.nic.in
# Required for AQI trigger
AQI_API_KEY=your_aqi_api_key_here

# ── Traffic API (HERE Maps) ────────────────────────────────────
# Sign up at https://developer.here.com (free tier available)
# Required for traffic stagnation trigger
TRAFFIC_API_KEY=your_here_maps_api_key_here

# ── Payments (Razorpay) ────────────────────────────────────────
# Sign up at https://razorpay.com — use test keys for development
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── SMS / OTP (Twilio) ─────────────────────────────────────────
# Sign up at https://www.twilio.com (free trial available)
# Required for phone OTP during worker registration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Application ────────────────────────────────────────────────
# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Trigger Thresholds (optional — defaults shown) ─────────────
# RAINFALL_THRESHOLD_MM=50.0
# AQI_THRESHOLD=300
# AQI_DURATION_MINS=60
# HEAT_THRESHOLD_CELSIUS=40.0
# HEAT_DURATION_MINS=90
# TRAFFIC_SPEED_THRESHOLD_KMH=8.0
# TRAFFIC_DURATION_MINS=90
